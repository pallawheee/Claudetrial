# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# ─── Gmail SMTP (for sending the daily digest) ────────────────────────────────
# Generate an App Password at: https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on your Google account)
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# ─── Newsletter Inbox (the email where newsletters arrive) ────────────────────
NEWSLETTER_INBOX_PASSWORD=your-newsletter-inbox-app-password-here

# ─── Anthropic API (for AI-powered insights) ──────────────────────────────────
# Get your API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
